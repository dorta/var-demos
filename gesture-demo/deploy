set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: $0 <board_ip_or_host> [remote_dir]" >&2
  echo "Example: $0 192.168.0.10 /opt/gesture-demo" >&2
  exit 2
fi

TARGET="root@$1"
REMOTE_DIR="${2:-/opt/gesture-demo}"
LOCAL_DIR="$(cd "$(dirname "$0")" && pwd)"

echo "Deploying $LOCAL_DIR -> $TARGET:$REMOTE_DIR"
tar -C "$LOCAL_DIR" -czf - . | ssh "$TARGET" "mkdir -p '$REMOTE_DIR' && tar -xzf - -C '$REMOTE_DIR'"

ssh "$TARGET" "chmod +x '$REMOTE_DIR/main.py' '$REMOTE_DIR/deploy'"

echo "Run on board:"
echo "  ssh $TARGET 'cd $REMOTE_DIR && python3 main.py --list-cameras'"
echo "  ssh $TARGET 'cd $REMOTE_DIR && python3 main.py --camera /dev/videoX --use-npu 1'"
