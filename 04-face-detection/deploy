#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: $0 <board_ip_or_host> [remote_dir]"
  exit 1
fi

HOST="$1"
REMOTE_DIR="${2:-/opt/04-face-detection}"

ssh "root@${HOST}" "mkdir -p '${REMOTE_DIR}'"
tar --exclude='.git' --exclude='__pycache__' -cf - . | ssh "root@${HOST}" "tar -xf - -C '${REMOTE_DIR}'"

echo "Deployed to root@${HOST}:${REMOTE_DIR}"
