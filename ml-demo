set -euo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
ML_DIR="$ROOT_DIR/machine-learning-demos/tflite/python/imx8mplus"

usage() {
    cat <<'EOF'
Usage: ./ml-demo <command> [demo options]

Commands:
  classify  Classify a still image
  detect    Detect objects in a still image
  classify-video  Classify a video
  detect-video    Detect objects in a video
  classify-camera Classify frames from a camera
  detect-camera   Detect objects in camera frames
  loop            Play the prepared GStreamer demo loop
  hd        Detect objects in an HD or Full HD video

Examples:
  ./ml-demo classify --headless --output-frame /tmp/classification.png
  ./ml-demo detect --headless --output-frame /tmp/detection.png
  ./ml-demo hd --combination 1 --source /path/to/video.mp4 \
    --headless --max-frames 1 --output-frame /tmp/hd-result.png
EOF
}

command_name="${1:-}"
if [[ -z "$command_name" || "$command_name" == "-h" || "$command_name" == "--help" ]]; then
    usage
    exit 0
fi
shift

case "$command_name" in
    classify) demo_dir="classification"; app="image_classification.py" ;;
    detect) demo_dir="detection"; app="image_detection.py" ;;
    classify-video) demo_dir="classification"; app="video_classification.py" ;;
    detect-video) demo_dir="detection"; app="video_detection.py" ;;
    classify-camera) demo_dir="classification"; app="realtime_classification.py" ;;
    detect-camera) demo_dir="detection"; app="realtime_detection.py" ;;
    loop) cd "$ROOT_DIR/demo-loop"; exec ./demo-loop.sh "$@" ;;
    hd) demo_dir="high-resolution-detection"; app="detection-hd-fullhd-video-npu.py" ;;
    *) echo "Unknown command: $command_name" >&2; usage >&2; exit 2 ;;
esac

cd "$ML_DIR/$demo_dir"
exec python3 "$app" "$@"
